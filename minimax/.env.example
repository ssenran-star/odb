# Copy to minimax/.env and fill in secrets locally. Never commit real keys.

# MiniMax OpenAPI (https://platform.minimax.io). Leave empty to use --dry-run.
MINIMAX_API_KEY=
# International: https://api.minimax.io/v1
# China:         https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TEMPERATURE=1
MINIMAX_MAX_TOKENS=8192
MINIMAX_TIMEOUT=180

# PowerContext HTTP API. The CLI starts a local server when the URL is loopback.
POWERCONTEXT_URL=http://127.0.0.1:8765
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE=
POWERCONTEXT_SCOPE_KEY=sdd-holiday-overtime
POWERCONTEXT_SCOPE_TITLE=SDD holiday overtime
POWERCONTEXT_HOME=

# Embedded seekdb (pyseekdb). SEEKDB_PATH is a data directory, not a single file.
SEEKDB_PATH=
SEEKDB_DATABASE=test
SEEKDB_COLLECTION=sdd_materials
